# Copy to .env (never commit it) and set these in your host's dashboard
# (Render/Replit: Environment / Secrets). Locally: node --env-file=.env index.js

# Required to enable the dashboard controls (/start, /stop, /command) and /logs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DASHBOARD_TOKEN=

# In-game /login or /register password used by auto-auth
AUTO_AUTH_PASSWORD=

# Only needed for premium (Microsoft) accounts
BOT_ACCOUNT_PASSWORD=

# Optional Discord webhook for connect/disconnect/chat notifications
DISCORD_WEBHOOK_URL=
